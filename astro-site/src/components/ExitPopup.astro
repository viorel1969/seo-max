---
import site from "../data/site.json";
---

<div id="popup-audit" class="exit-intent-popup hidden fixed inset-0 z-[9999] items-center justify-center bg-black/55 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="popup-audit-titlu">
  <div class="relative w-[90%] max-w-[480px] rounded-2xl bg-white px-8 py-9 shadow-[0_20px_60px_rgba(0,0,0,0.3)]">
    <button data-popup-close type="button" aria-label="Închide popup" class="absolute right-4 top-3.5 cursor-pointer border-0 bg-transparent text-xl leading-none text-gray-400 hover:text-gray-600">✕</button>

    <div class="mb-6 text-center">
      <div class="mb-2 text-4xl">🎯</div>
      <h2 id="popup-audit-titlu" class="mb-2 text-[22px] font-extrabold text-gray-900">Înainte să pleci - audit SEO gratuit</h2>
      <p class="text-[15px] text-gray-500">Îți analizez site-ul în 48h și îți spun exact ce îl ține pe loc în Google.</p>
    </div>

    <form id="popup-form" data-api-url="/api/lead-capture">
      <div class="mb-3">
        <input type="text" id="popup-website" name="popup-website" placeholder="site-ul-tau.ro" required aria-label="URL-ul site-ului tau" class="popup-input w-full rounded-[10px] border-2 border-gray-200 px-3.5 py-3 text-[15px] text-gray-900 box-border focus:border-orange-500 focus:outline-none" />
      </div>
      <div class="mb-3">
        <input type="email" id="popup-email" name="popup-email" placeholder="Email-ul tău" required aria-label="Adresa ta de email" class="popup-input w-full rounded-[10px] border-2 border-gray-200 px-3.5 py-3 text-[15px] text-gray-900 box-border focus:border-orange-500 focus:outline-none" />
      </div>
      <div class="mb-5">
        <input type="tel" id="popup-telefon" name="popup-telefon" placeholder="Telefon (opțional)" aria-label="Numar de telefon (optional)" class="popup-input w-full rounded-[10px] border-2 border-gray-200 px-3.5 py-3 text-[15px] text-gray-900 box-border focus:border-orange-500 focus:outline-none" />
      </div>
      <div class="mb-3 flex items-start">
        <input type="checkbox" id="popup-politica" name="accepta_politica_confidentialitate" required class="mt-1 w-4 h-4 text-orange-500 border-gray-300 rounded focus:ring-orange-500" />
        <label for="popup-politica" class="ml-3 text-sm text-gray-700 font-semibold">
          Accept <a href={`${site.basePath}/politica-confidentialitate`} class="text-blue-600 hover:underline" target="_blank">Politica de Confidențialitate</a> <span class="text-red-600">*</span>
        </label>
      </div>
      <div class="mb-5 flex items-start">
        <input type="checkbox" id="popup-termeni" name="accepta_termeni_conditii" required class="mt-1 w-4 h-4 text-orange-500 border-gray-300 rounded focus:ring-orange-500" />
        <label for="popup-termeni" class="ml-3 text-sm text-gray-700 font-semibold">
          Accept <a href={`${site.basePath}/termeni-conditii`} class="text-blue-600 hover:underline" target="_blank">Termenii și Condițiile</a> <span class="text-red-600">*</span>
        </label>
      </div>

      <button type="submit" id="popup-btn" class="w-full cursor-pointer rounded-[10px] border-0 bg-orange-500 py-3.5 text-base font-bold text-white transition-colors hover:bg-orange-600">
        Vreau auditul gratuit →
      </button>
      <div id="popup-msg" class="mt-3 min-h-[20px] text-center text-sm"></div>
    </form>

    <p class="mt-3.5 text-center text-xs text-gray-400">Fără spam. Fără obligații. Răspund personal.</p>
  </div>
</div>

<script>
  // Exit-intent simplu: arata popup-ul cand mouse-ul paraseste fereastra pe sus (desktop)
  const popup = document.getElementById("popup-audit");
  const closeBtn = popup?.querySelector("[data-popup-close]");
  let shown = false;

  document.addEventListener("mouseout", (e) => {
    if (shown || window.innerWidth < 768) return;
    if (e.clientY <= 0) {
      popup?.classList.remove("hidden");
      popup?.classList.add("flex");
      shown = true;
    }
  });

  closeBtn?.addEventListener("click", () => {
    popup?.classList.add("hidden");
    popup?.classList.remove("flex");
  });
</script>
